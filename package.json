{
  "name": "content-autopilot",
  "version": "0.1.0",
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "tsx watch src/worker.ts",
    "start": "tsx src/worker.ts",
    "cli": "tsx src/cli.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "build:web": "npm --prefix web ci --include=dev && npm --prefix web run build",
    "build": "npm run build:web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:web": "npm --prefix web test"
  },
  "type": "module",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^18.0.5",
    "ffmpeg-static": "^5.3.0",
    "grammy": "^1.46.0",
    "linkedom": "^0.18.13",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "rss-parser": "^3.13.0",
    "satori": "^0.33.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.2"
  }
}
