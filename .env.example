# Supabase session pooler URL (Connect → Session pooler). The direct db.*.supabase.co host is IPv6-only.
DATABASE_URL=
# Set false for a local or CI Postgres without SSL (default: true, as Supabase requires).
# DATABASE_SSL=true

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_RANK_MODEL=anthropic/claude-haiku-4.5

# Threads. Keep DRY_RUN=true until the Meta app and long-lived token exist.
THREADS_DRY_RUN=true
# One-time token setup: put the Threads app ID/secret here, then run
#   npm run cli -- threads:auth-url   and   npm run cli -- threads:token <code>
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Telegram review bot (@BotFather). Send /start to the bot to learn TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Schedule (defaults shown)
# TZ_NAME=Asia/Seoul
# COLLECT_CRON=0 6 * * *
# DAILY_POST_COUNT=3
# PUBLISH_SLOTS=08:00,12:30,21:00

# Thread chains: main post + up to 2 own replies (docs/decisions.md 8)
# THREAD_CHAIN_ENABLED=false
# Appended to the last reply of a chain only; \n becomes a line break
# THREAD_CTA_TEXT=개발자 관점 AI 소식을 매일 정리합니다.\n도움이 됐다면 팔로우해 주세요.

# ---- 체험단 파이프라인: 카카오톡 선물하기 (docs/plans/campaign-autopilot.md, docs/setup.md 5절) ----
# 공개 목록을 읽는 시각 (TZ_NAME 기준). 계정이나 토큰은 필요 없다.
# GIFT_COLLECT_CRON=0 9,15,21 * * *
# 선물하기 체험단 탭의 페이지 번호 (gift.kakao.com/page/<번호>)
# GIFT_TRIAL_PAGE_ID=33325
# 하루에 Telegram으로 보낼 카드 최대 개수 (1~20)
# CAMPAIGN_DAILY_MAX=5
# 선별 규칙과 리뷰 문체, 광고 표기 프로필
# CAMPAIGN_PROFILE_PATH=config/campaign-profile.json

# ---- 체험단 파이프라인: 무신사 프리유저 (docs/setup.md 5-4절, docs/operations.md) ----
# 무신사 목록은 내 로그인이 필요해서 내 Windows PC의 Aside 브라우저로만 읽는다.
# 그 PC의 .env에는 클라우드와 같은 DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID를 넣고
# WORKER_ROLE=local을 추가한다. 로컬 워커는 무신사 수집만 한다(마이그레이션, 텔레그램 폴링, Threads, 대시보드 없음).
# cloud(기본) 또는 local. 클라우드 서버에는 설정하지 않는다.
# WORKER_ROLE=cloud
# 무신사 목록을 읽는 시각 (TZ_NAME 기준). 두 역할 모두 스케줄을 등록하므로 바꾸려면 양쪽 값을 같게 둔다
# MUSINSA_COLLECT_CRON=0 10,16,22 * * *
# Aside CLI 경로. 비우면 %LOCALAPPDATA%\Aside\CLI\current\aside.exe가 있을 때 그것, 없으면 PATH의 aside
# ASIDE_BIN=
# Aside CLI 계정. 계정이 여러 개일 때만 넣는다 (aside account list로 확인)
# ASIDE_ACCOUNT=

# ---- 읽기 전용 웹 대시보드 (docs/dashboard.md) ----
# 설정하면 워커에서 대시보드가 켜진다 (Basic 인증 비밀번호).
# DASHBOARD_PASSWORD=
# Railway가 자동으로 주입한다 (기본 8080)
# PORT=8080
