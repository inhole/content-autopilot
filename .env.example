# Supabase session pooler URL (Connect → Session pooler). The direct db.*.supabase.co host is IPv6-only.
DATABASE_URL=
# Set false for a local or CI Postgres without SSL (default: true, as Supabase requires).
# DATABASE_SSL=true

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_RANK_MODEL=anthropic/claude-haiku-4.5

# Threads. Keep DRY_RUN=true until the Meta app and long-lived token exist.
THREADS_DRY_RUN=true
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Telegram review bot (@BotFather). Send /start to the bot to learn TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Liveness monitoring (healthchecks.io style, both optional). The worker's own Telegram alerts
# cannot fire when it is dead, so an external service must notice missing pings.
# HEALTHCHECK_URL: pinged every 5 minutes while the worker runs.
HEALTHCHECK_URL=
# HEALTHCHECK_DAILY_URL: pinged after each successful daily pipeline run, and <url>/fail when it
# fails on its last retry. Give this check a grace period beyond the daily schedule.
HEALTHCHECK_DAILY_URL=

# Schedule (defaults shown)
# TZ_NAME=Asia/Seoul
# COLLECT_CRON=0 6 * * *
# DAILY_POST_COUNT=3
# PUBLISH_SLOTS=08:00,12:30,19:00
