# Supabase session pooler URL (Connect → Session pooler). The direct db.*.supabase.co host is IPv6-only.
DATABASE_URL=
# Set false for a local or CI Postgres without SSL (default: true, as Supabase requires).
# DATABASE_SSL=true

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_RANK_MODEL=anthropic/claude-haiku-4.5

# Threads. Keep DRY_RUN=true until the Meta app and long-lived token exist.
THREADS_DRY_RUN=true
# One-time token setup: put the Threads app ID/secret here, then run
#   npm run cli -- threads:auth-url   and   npm run cli -- threads:token <code>
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Telegram review bot (@BotFather). Send /start to the bot to learn TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Schedule (defaults shown)
# TZ_NAME=Asia/Seoul
# COLLECT_CRON=0 6 * * *
# DAILY_POST_COUNT=3
# PUBLISH_SLOTS=08:00,12:30,21:00

# Thread chains: main post + up to 2 own replies (docs/decisions.md 8)
# THREAD_CHAIN_ENABLED=false
# Appended to the last reply of a chain only; \n becomes a line break.
# Recommended: leave it UNSET (the owner decided on no CTA, docs/decisions.md 7-8).
# THREAD_CTA_TEXT=

# ---- 체험단 파이프라인: 카카오톡 선물하기 (docs/plans/campaign-autopilot.md, docs/setup.md 5절) ----
# 공개 목록을 읽는 시각 (TZ_NAME 기준). 계정이나 토큰은 필요 없다.
# GIFT_COLLECT_CRON=0 9,15,21 * * *
# 선물하기 체험단 탭의 페이지 번호 (gift.kakao.com/page/<번호>)
# GIFT_TRIAL_PAGE_ID=33325
# 하루에 Telegram으로 보낼 카드 최대 개수 (1~20)
# CAMPAIGN_DAILY_MAX=5
# 선별 점수 방식: rule(코드 규칙, LLM 호출 없음) 또는 llm(LLM_RANK_MODEL)
# CAMPAIGN_RANK_MODE=rule
# 선별 규칙과 리뷰 문체, 광고 표기 프로필
# CAMPAIGN_PROFILE_PATH=config/campaign-profile.json

# ---- 체험단 파이프라인: 무신사 프리유저 (docs/setup.md 5-4절, docs/operations.md) ----
# 무신사 체험단 목록은 공개 API라 로그인이 필요 없고, 클라우드 워커가 읽는다.
# 무신사 목록을 읽는 시각 (TZ_NAME 기준)
# MUSINSA_COLLECT_CRON=0 10,16,22 * * *

# ---- Aside 브라우저 스크립트 (docs/aside.md, CLI 전용) ----
# 기본은 %LOCALAPPDATA%\Aside\CLI\current\aside.exe, 없으면 PATH의 aside
# ASIDE_BIN=
# Aside CLI 계정이 여럿일 때 (예: u1)
# ASIDE_ACCOUNT=

# ---- 웹 대시보드 (docs/dashboard.md) ----
# TELEGRAM_BOT_TOKEN과 TELEGRAM_CHAT_ID가 있으면 켜진다. 로그인 코드는 그 채팅으로 간다.
# Railway가 자동으로 주입한다 (기본 8080)
# PORT=8080
# 대시보드의 공개 https 주소 (경로 없이). 설정하고 대시보드를 켜면 선물하기 카드의 버튼이
# 카카오톡 앱으로 바로 열린다 (/go/gift/<id>). 예: https://content-autopilot-production-xxxx.up.railway.app
# PUBLIC_BASE_URL=

# ---- 숏폼 영상: Instagram Reels / YouTube Shorts (docs/plans/video.md, docs/setup.md 6절) ----
# 자동 선택 일정(화·목·토 07:00)을 켠다. 꺼져 있어도 /video 와 CLI는 동작한다.
# VIDEO_ENABLED=false
# VIDEO_CRON=0 7 * * 2,4,6
# VIDEO_WEEKLY_MAX=3
# 영상 발행 시각 (하루 하나)
# VIDEO_PUBLISH_SLOT=19:00
# 자동 발행할 플랫폼: reels, shorts (쉼표). 비우면 직접 올리고 📤 버튼으로 기록
# VIDEO_PLATFORMS=
# 실제 Instagram/YouTube 호출은 false로 바꿔야 나간다
# VIDEO_PUBLISH_DRY_RUN=true
# 화면 위쪽과 출처 카드에 나오는 이름 (예: @devbrief.kr)
# VIDEO_BRAND=
# silent(무음, 기본) | google | openai | elevenlabs. video:tts-sample 로 비교해서 고른다
# VIDEO_TTS_PROVIDER=silent
# 공급자별 음성 (google 기본 ko-KR-Chirp3-HD-Charon, openai 기본 alloy, elevenlabs는 음성 id 필수)
# VIDEO_TTS_VOICE=
# GOOGLE_TTS_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# 배경음악 파일 (선택, 저작권 문제 없는 것만)
# VIDEO_BGM_PATH=
# local(기본, VIDEO_LOCAL_DIR) | supabase(공개 버킷, Reels에 필요)
# VIDEO_STORAGE=local
# VIDEO_LOCAL_DIR=data/videos
# 관리자 콘솔에서 직접 올릴 수 있는 영상 최대 크기(MB, 1~200). Supabase 무료 플랜 파일당 한도와 같다
# VIDEO_UPLOAD_MAX_MB=50
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# VIDEO_STORAGE_BUCKET=videos
# Instagram 로그인 방식 API. 처음 한 번 넣으면 DB로 옮겨지고 자동 갱신된다
# INSTAGRAM_API_BASE=https://graph.instagram.com/v24.0
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# YouTube 데스크톱 OAuth 클라이언트. npm run cli -- youtube:auth 로 한 번 인증
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_PRIVACY=public
